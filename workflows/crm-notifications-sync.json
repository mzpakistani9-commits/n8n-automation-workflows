{
  "name": "[4] CRM & Notifications Sync",
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "crm-event",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "crm-webhook",
      "name": "Webhook (CRM event)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -760,
        0
      ],
      "webhookId": "7c31de40-5f4d-6c8d-be3f-crmsync000001"
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json;\nreturn [{\n  json: {\n    event: raw.event || 'updated',\n    contactId: raw.contactId,\n    name: (raw.name || '').trim(),\n    email: (raw.email || '').trim().toLowerCase(),\n    stage: (raw.stage || 'lead').toLowerCase(),\n    restaurantId: raw.restaurantId || null\n  }\n}];"
      },
      "id": "crm-normalize",
      "name": "Code: Normalize Event",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -540,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "={{ $json.event }}",
              "rightValue": "created",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ]
        },
        "options": {}
      },
      "id": "crm-if-created",
      "name": "IF event = created",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        -320,
        0
      ]
    },
    {
      "parameters": {
        "options": {
          "notifyOnSuccess": true
        },
        "resource": "row",
        "operation": "create",
        "documentId": {
          "__rl": true,
          "value": "CRM-SHEET-ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Contacts",
          "mode": "list"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "contactId": "={{ $json.contactId }}",
            "name": "={{ $json.name }}",
            "email": "={{ $json.email }}",
            "stage": "={{ $json.stage }}",
            "restaurantId": "={{ $json.restaurantId }}"
          }
        }
      },
      "id": "crm-sheets",
      "name": "Google Sheets: Add Row",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [
        -100,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.hubspot.com/crm/v3/objects/contacts",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{ $env.HUBSPOT_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "=JSON.stringify({\n  properties: {\n    firstname: $json.name.split(' ')[0],\n    lastname: $json.name.split(' ').slice(1).join(' '),\n    email: $json.email,\n    hubspot_owner_id: $env.HUBSPOT_OWNER_ID\n  }\n})",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "crm-hubspot",
      "name": "HubSpot: Upsert Contact",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -100,
        120
      ]
    },
    {
      "parameters": {
        "text": "New {{ $json.stage }} contact: {{ $json.name }} ({{ $json.email }}) -> {{ $json.restaurantId }}",
        "options": {}
      },
      "id": "crm-slack",
      "name": "Slack: #sales",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 4,
      "position": [
        -100,
        240
      ]
    },
    {
      "parameters": {
        "options": {}
      },
      "id": "crm-respond",
      "name": "Respond 200",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        -100,
        360
      ],
      "webhookId": "7c31de40-5f4d-6c8d-be3f-crmsync000001"
    }
  ],
  "connections": {
    "Webhook (CRM event)": {
      "main": [
        [
          {
            "node": "Code: Normalize Event",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Code: Normalize Event": {
      "main": [
        [
          {
            "node": "IF event = created",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "IF event = created": {
      "main": [
        [
          {
            "node": "Google Sheets: Add Row",
            "type": "main",
            "index": 0
          },
          {
            "node": "HubSpot: Upsert Contact",
            "type": "main",
            "index": 0
          },
          {
            "node": "Slack: #sales",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    },
    "Google Sheets: Add Row": {
      "main": [
        [
          {
            "node": "Respond 200",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "HubSpot: Upsert Contact": {
      "main": [
        [
          {
            "node": "Respond 200",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "id": "b5c40051-a47c-5fdb-936b-9655196fe16b"
}