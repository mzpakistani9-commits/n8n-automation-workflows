{
  "name": "[5] Social Media Lead Capture",
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "social-lead",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "social-webhook",
      "name": "Webhook (comment/DM)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-760, 0],
      "webhookId": "8d42ef51-6a5e-7d9e-cf40-sociallead0001"
    },
    {
      "parameters": {
        "jsCode": "// In production this fires from an Instagram/WhatsApp/Meta webhook.\n// The connector posts the raw payload here.\nconst raw = $input.first().json;\nconst text = (raw.text || raw.message || raw.comment || '').trim();\nconst yes = /(yes|interested|price|quote|notes|cost|how much)/i;\nconst intent = yes.test(text) ? 'high' : 'low';\nreturn [{\n  json: {\n    channel: raw.channel || 'instagram',\n    handler: (raw.username || raw.from || 'unknown').replace(/[^a-zA-Z0-9_]/g, ''),\n    text: text,\n    intent: intent,\n    ts: raw.ts || Date.now()\n  }\n}];"
      },
      "id": "social-extract",
      "name": "Code: Extract Lead",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-540, 0]
    },
    {
      "parameters": {
        "options": {
          "response": {
            "response": "text",
            "limit": "300"
          },
          "model": {
            "temperature": 0
          }
        },
        "resource": "chat",
        "modelId": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-4o-mini"
        },
        "messages": {
          "values": [
            {
              "role": "user",
              "content": "Is this a genuine buying-intent lead or noise? Return ONLY JSON {isLead: bool, reason}\n\nChannel={{ $json.channel }} Handler={{ $json.handler }} Message={{ $json.text }}"
            }
          ]
        }
      },
      "id": "social-llm",
      "name": "AI: Buying Intent",
      "type": "n8n-nodes-base.openAi",
      "typeVersion": 2,
      "position": [-320, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "={{ $json.isLead }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ]
        },
        "options": {}
      },
      "id": "social-if-lead",
      "name": "IF isLead = true",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [-100, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:5678/webhook/lead-intake",
        "authentication": "none",
        "sendHeaders": false,
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "=JSON.stringify({\n  name: $json.handler,\n  email: $json.handler + '@social.example',\n  company: '',\n  source: $json.channel,\n  budget: 0,\n  message: $json.text\n})",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "social-fwd",
      "name": "Forward to Lead Pipeline",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [120, 0]
    },
    {
      "parameters": {
        "options": {}
      },
      "id": "social-ack",
      "name": "Respond 201 (saved)",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [120, 120],
      "webhookId": "8d42ef51-6a5e-7d9e-cf40-sociallead0001"
    }
  ],
  "connections": {
    "Webhook (comment/DM)": {
      "main": [[{ "node": "Code: Extract Lead", "type": "main", "index": 0 }]]
    },
    "Code: Extract Lead": {
      "main": [[{ "node": "AI: Buying Intent", "type": "main", "index": 0 }]]
    },
    "AI: Buying Intent": {
      "main": [[{ "node": "IF isLead = true", "type": "main", "index": 0 }]]
    },
    "IF isLead = true": {
      "main": [
        [{ "node": "Forward to Lead Pipeline", "type": "main", "index": 0 }],
        [{ "node": "Respond 201 (saved)", "type": "main", "index": 0 }]
      ]
    },
    "Forward to Lead Pipeline": {
      "main": [[{ "node": "Respond 201 (saved)", "type": "main", "index": 0 }]]
    }
  }
}