{
  "name": "[1] Lead Intake & Qualification",
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "lead-intake",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "lead-webhook",
      "name": "Webhook (Lead form)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-760, 0],
      "webhookId": "5a1f9c2e-3d2b-4a6b-9c1d-leadhub0001"
    },
    {
      "parameters": {
        "jsCode": "// Normalize: trim, lowercase email, default source.\nconst raw = $input.first().json;\nconst lead = {\n  name: (raw.name || '').trim(),\n  email: (raw.email || '').trim().toLowerCase(),\n  company: (raw.company || '').trim(),\n  source: (raw.source || 'website'),\n  budget: Number(raw.budget) || 0,\n  message: (raw.message || '')\n};\nreturn [{ json: lead }];"
      },
      "id": "lead-normalize",
      "name": "Code: Normalize Lead",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-540, 0]
    },
    {
      "parameters": {
        "options": {},
        "resource": "chat",
        "modelId": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-4o-mini"
        },
        "messages": {
          "values": [
            {
              "role": "user",
              "content": "You are a BDR scoring system. Rate this lead 0-100 on fit and intent.\nRules:\n- 80+: sales-ready -> route to instant email + CRM.\n- 40-79: nurture -> tag and follow up in 3 days.\n- <40: cold -> archive.\n\nReturn ONLY JSON: {score, tier, reason}\n\nLead: name={{ $json.name }} company={{ $json.company }} budget={{ $json.budget }} message={{ $json.message }}"
            }
          ]
        },
        "options": {
          "response": {
            "response": "text",
            "limit": "500"
          },
          "model": {
            "temperature": 0
          }
        },
        "useOutputParser": true,
        "outputParser": {
          "json": {
            "schema": {
              "properties": [
                { "key": "score", "type": "integer" },
                { "key": "tier", "type": "string" },
                { "key": "reason", "type": "string" }
              ],
              "type": "object"
            },
            "textarea": "{\n  \"score\": 85,\n  \"tier\": \"sales-ready\",\n  \"reason\": \"specific workflow need + budget\"\n}",
            "type": "json"
          },
          "type": "json"
        }
      },
      "id": "lead-llm",
      "name": "AI: Qualify Lead",
      "type": "n8n-nodes-base.openAi",
      "typeVersion": 2,
      "position": [-320, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "={{ $json.score }}",
              "rightValue": "80",
              "operator": {
                "type": "number",
                "operation": "gte"
              }
            }
          ]
        },
        "options": {}
      },
      "id": "lead-if",
      "name": "IF score >= 80",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [-100, 0]
    },
    {
      "parameters": {
        "matchType": "defined",
        "regex": "",
        "jsCode": "const tier = $input.first().json.tier;\nlet operator, subject, body;\nif (tier === 'sales-ready') {\n  operator = 'sales@example.com';\n  subject = 'Hot lead: ' + $json.name;\n  body = 'Book intro call ASAP: ' + $json.email;\n} else if (tier === 'nurture') {\n  operator = 'marketing@example.com';\n  subject = 'Nurture: ' + $json.name;\n  body = 'Add to 3-day follow-up drip.';\n} else {\n  operator = 'ops@example.com';\n  subject = 'Archive: ' + $json.name;\n  body = 'Cold lead, tier=' + $json.tier;\n}\nreturn [{ json: { ...$json, operator, subject, body } }];"
      },
      "id": "lead-route",
      "name": "Code: Route by Tier",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [120, 0]
    },
    {
      "parameters": {
        "operation": "create",
        "table": {
          "__rl": true,
          "value": "Leads",
          "mode": "list"
        },
        "fields": {
          "mappingMode": "defineBelow",
          "value": {
            "name": "={{ $json.name }}",
            "email": "={{ $json.email }}",
            "tier": "={{ $json.tier }}",
            "score": "={{ $json.score }}",
            "source": "={{ $json.source }}",
            "budget": "={{ $json.budget }}",
            "reason": "={{ $json.reason }}"
          }
        },
        "options": {}
      },
      "id": "lead-crm",
      "name": "CRM: Upsert Lead",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 4,
      "position": [340, 0]
    },
    {
      "parameters": {
        "fromEmail": "n8n@example.com",
        "toEmail": "={{ $json.operator }}",
        "subject": "={{ $json.subject }}",
        "text": "={{ $json.body }}",
        "options": {}
      },
      "id": "lead-email",
      "name": "Email: Alert Owner",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 1,
      "position": [340, 120]
    },
    {
      "parameters": {
        "options": {}
      },
      "id": "lead-success",
      "name": "Respond Success",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [340, 240],
      "webhookId": "5a1f9c2e-3d2b-4a6b-9c1d-leadhub0001"
    }
  ],
  "connections": {
    "Webhook (Lead form)": {
      "main": [[{ "node": "Code: Normalize Lead", "type": "main", "index": 0 }]]
    },
    "Code: Normalize Lead": {
      "main": [[{ "node": "AI: Qualify Lead", "type": "main", "index": 0 }]]
    },
    "AI: Qualify Lead": {
      "main": [[{ "node": "IF score >= 80", "type": "main", "index": 0 }]]
    },
    "IF score >= 80": {
      "main": [
        [{ "node": "Code: Route by Tier", "type": "main", "index": 0 }],
        [{ "node": "Code: Route by Tier", "type": "main", "index": 0 }]
      ]
    },
    "Code: Route by Tier": {
      "main": [
        [
          { "node": "CRM: Upsert Lead", "type": "main", "index": 0 },
          { "node": "Email: Alert Owner", "type": "main", "index": 0 }
        ]
      ]
    },
    "CRM: Upsert Lead": {
      "main": [[{ "node": "Respond Success", "type": "main", "index": 0 }]]
    }
  }
}