{
  "name": "[3] Daily Ops Report",
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "triggerAtHour": 9
            }
          ]
        }
      },
      "id": "report-trigger",
      "name": "Schedule (Daily 09:00)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [-540, 0]
    },
    {
      "parameters": {
        "jsCode": "const rows = [\n  { metric: 'New leads', value: 12 },\n  { metric: 'Converted', value: 3 },\n  { metric: 'Tickets closed', value: 9 },\n  { metric: 'No-shows', value: 1 },\n  { metric: 'Revenue (PKR)', value: 184000 }\n];\n// In production: replace with a join over the CRM/ticket databases.\nreturn rows.map(r => ({ json: r }));"
      },
      "id": "report-data",
      "name": "Code: Pull Metrics",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-320, 0]
    },
    {
      "parameters": {
        "options": {
          "response": {
            "response": "text",
            "limit": "600"
          },
          "model": {
            "temperature": 0.2
          }
        },
        "resource": "chat",
        "modelId": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-4o-mini"
        },
        "messages": {
          "values": [
            {
              "role": "user",
              "content": "Turn these daily metrics into a short executive report for the ops team (3-4 sentences, plain text, surface 1 risk and 1 win).\n\n{{ JSON.stringify($input.all().map(i => i.json)) }}"
            }
          ]
        }
      },
      "id": "report-llm",
      "name": "AI: Summarize Report",
      "type": "n8n-nodes-base.openAi",
      "typeVersion": 2,
      "position": [-100, 0]
    },
    {
      "parameters": {
        "fromEmail": "n8n@example.com",
        "toEmail": "ops@example.com",
        "subject": "Daily Ops Report — {{ $now.toFormat('yyyy-MM-dd') }}",
        "text": "={{ $json }}",
        "options": {}
      },
      "id": "report-email",
      "name": "Email: Ops Team",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 1,
      "position": [120, 0]
    },
    {
      "parameters": {
        "text": "Daily report sent.\n{{ $json }}",
        "options": {}
      },
      "id": "report-slack",
      "name": "Slack: #ops-report",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 4,
      "position": [120, 120]
    }
  ],
  "connections": {
    "Schedule (Daily 09:00)": {
      "main": [[{ "node": "Code: Pull Metrics", "type": "main", "index": 0 }]]
    },
    "Code: Pull Metrics": {
      "main": [[{ "node": "AI: Summarize Report", "type": "main", "index": 0 }]]
    },
    "AI: Summarize Report": {
      "main": [
        [
          { "node": "Email: Ops Team", "type": "main", "index": 0 },
          { "node": "Slack: #ops-report", "type": "main", "index": 0 }
        ]
      ]
    }
  }
}